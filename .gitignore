# ==============================================================================
# Project-specific generated artifacts
# ==============================================================================
# Repomix packs the entire codebase into a single file - never commit it.
repomix-output.txt
repomix-output.*
.repomix/

# ==============================================================================
# Terraform
# ==============================================================================
# Provider plugins and downloaded modules (this is what broke the push:
# terraform-provider-aws is ~674 MB per platform).
**/.terraform/*
.terraform.d/
.terraform.tfstate.lock.info

# State files (state lives in S3, but never commit local state backups)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Override files (machine-local)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config (if placed in repo root instead of ~/.terraformrc)
.terraformrc
terraform.rc

# Plan output (may contain secrets and resource data)
*.tfplan
tfplan
tfplan.*
*.tfplan.json

# Auto-loaded tfvars (usually hold real values; commit templates instead)
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# NOTE: keep the following under version control (do NOT add to this file):
#   - infra/terraform/**/.terraform.lock.hcl   (pins provider versions)
#   - infra/terraform/app/envs/*.tfvars      (templates with REPLACE markers)
#   - infra/terraform/app/envs/*.backend.hcl (templates)

# ==============================================================================
# Node.js (SPA under apps/**, any Node tooling)
# ==============================================================================
node_modules/
.pnp
.pnp.*
.npm/
.yarn/
.pnpm-store/

# Build output (Vite / Next / SvelteKit / etc.)
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.svelte-kit/
.vite/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/
*.lcov
.eslintcache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ==============================================================================
# Python (only if apps/api is Python)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
uv.lock.bak
poetry.lock.bak

# ==============================================================================
# Secrets, keys, and certificates (CRITICAL for a PKI project)
# ==============================================================================
# Environment files - commit only the .example variants
.env
.env.*
!.env.example
!.env.*.example

# Any secrets directories
secrets/
secret/
*.secret
*.secrets

# GnuPG home / private keyrings
.gnupg/
gnupg/
*.gpg
*.kbx
*.keyring
S.gpg-agent*

# Private key and certificate material
# NOTE: if you intentionally commit test fixtures (e.g. tests/fixtures/*.crt),
# add explicit exceptions below, e.g.:
#   !apps/**/tests/fixtures/*.crt
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.crt
*.cer
*.csr
*.der
*.p7b
*.p7c

# SSH keys
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk

# AWS CLI caches (should live in $HOME, but just in case)
.aws/
.aws-sam/

# ==============================================================================
# Dev container / local overrides
# ==============================================================================
.devcontainer/.env
.devcontainer/.env.*
.devcontainer/local/

# ==============================================================================
# IDEs and editors
# ==============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.history/
*.code-workspace

# ==============================================================================
# OS files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==============================================================================
# Temporary files
# ==============================================================================
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
